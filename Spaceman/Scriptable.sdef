<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">

<dictionary title="App Scripting Terminology">
    
    <suite name="Spaceman Suite" code="smsu" description="Spaceman Scripts">

        <command name="refresh" code="smsurcmd" description="Refresh Spaceman">
            <cocoa class="Spaceman.RefreshCommand" />
        </command>

        <command name="open preferences" code="smsupcmd" description="Open Preferences Window">
            <cocoa class="Spaceman.OpenPreferencesCommand" />
        </command>

        <command name="restore preferences" code="smsurstr" description="Restore Preferences from Backup">
            <cocoa class="Spaceman.RestorePreferencesCommand" />
        </command>

        <command name="switch to space" code="smsuswsp"
                 description="Switch to a space by its name or number, or by its macOS space id">
            <cocoa class="Spaceman.SwitchToSpaceCommand" />
            <direct-parameter optional="yes"
                              description="The space name, or its number as given by 'current space number'">
                <type type="text"/>
                <type type="integer"/>
            </direct-parameter>
            <parameter name="with space id" code="SpID" type="integer" optional="yes"
                       description="The macOS ManagedSpaceID; it changes after a reboot or wake">
                <cocoa key="spaceID"/>
            </parameter>
            <result type="boolean"
                    description="true when the switch has started, or the space is already current"/>
        </command>

        <class name="application" code="capp" description="The Spaceman application">
            <cocoa class="NSApplication"/>
            <property name="current space number" code="SpNo" type="integer" access="r"
                      description="The number of the current space on the frontmost display">
                <cocoa key="currentSpaceNumber"/>
            </property>
            <property name="current space name" code="SpNa" type="text" access="r"
                      description="The user-assigned name of the current space on the frontmost display">
                <cocoa key="currentSpaceName"/>
            </property>
            <property name="display count" code="DpCt" type="integer" access="r"
                      description="The number of displays currently connected">
                <cocoa key="displayCount"/>
            </property>
            <property name="current display number" code="DpNo" type="integer" access="r"
                      description="The 1-based index of the frontmost display">
                <cocoa key="currentDisplayNumber"/>
            </property>
        </class>

    </suite>

</dictionary>
