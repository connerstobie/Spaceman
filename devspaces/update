#!/usr/bin/python3
"""update: update Chrome, VS Code and the Claude Code extension, then reopen every
VS Code window on the Spaceman Space it came from. One command, no options needed.

It builds or installs whatever it needs on its own (the spacectl helper, the VS Code
helper extension, ~/Applications/Update.app), shows what will update, asks once, then
hands the job to Update.app, which survives VS Code quitting and has its own macOS
permissions. "Update" in Spotlight runs the same job.

Logs: ~/Library/Logs/devspaces/. State: ~/Library/Application Support/devspaces/.
Standard library only; runs on the system /usr/bin/python3 (3.9).
"""

import argparse
import datetime
import fcntl
import hashlib
import json
import os
import plistlib
import re
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
import uuid
import zipfile
from pathlib import Path

HOME = Path.home()
REPO = Path(__file__).resolve().parent
STATE = HOME / "Library/Application Support/devspaces"
LOGS = HOME / "Library/Logs/devspaces"
SPACECTL = STATE / "bin/spacectl"
SNAPSHOT = STATE / "snapshot.json"
HANDOFF = STATE / "handoff.json"
LOCK = STATE / "lock"
REQUESTS = STATE / "requests"
RESPONSES = STATE / "responses"
READY = STATE / "ready"
APP = HOME / "Applications/Update.app"
APP_ID = "io.github.connerstobie.update"

VSCODE = Path("/Applications/Visual Studio Code.app")
VSCODE_ID = "com.microsoft.VSCode"
VSCODE_BINARY = VSCODE / "Contents/MacOS/Code"
CODE_CLI = VSCODE / "Contents/Resources/app/bin/code"
VSCODE_USER = HOME / "Library/Application Support/Code/User"
VSCODE_UPDATE_API = "https://update.code.visualstudio.com/api/update/darwin-universal/stable/"
SHIPIT_STATE = HOME / "Library/Caches/com.microsoft.VSCode.ShipIt/ShipItState.plist"
CHROME = Path("/Applications/Google Chrome.app")
CHROME_ID = "com.google.Chrome"
CHROME_BINARY = CHROME / "Contents/MacOS/Google Chrome"
CHROME_USER = HOME / "Library/Application Support/Google/Chrome"
GOOGLE_UPDATER = HOME / (
    "Library/Application Support/Google/GoogleUpdater/Current/GoogleUpdater.app/Contents/MacOS/GoogleUpdater"
)
